create or replace function public.purge_dossier(p_class text) returns void
language plpgsql security definer set search_path to 'public' as $$
begin
    if not exists (select 1 from classes where code = p_class and owner = auth.uid()) then
        raise exception 'Action non autorisée.' using errcode = '42501';
    end if;
    delete from candidacy_forms where class_code = p_class;
    delete from minutes         where class_code = p_class;
end $$;

revoke all on function public.purge_dossier(text) from public;
grant execute on function public.purge_dossier(text) to authenticated;

-- Au cas où les droits/politiques manqueraient aussi :
grant delete on public.classes, public.candidacy_forms, public.minutes to authenticated;
drop policy if exists classes_delete on public.classes;
create policy classes_delete on public.classes for delete
    using (owner = auth.uid() and public.is_teacher());
